generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KycType {
  bvn
  nin
}

enum TransactionStatus {
  pending
  successful
  failed
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String

  kycType      KycType
  kycID        String   @unique
  dateOfBirth  DateTime
  isVerified   Boolean  @default(false)

  account      Account?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id            String   @id @default(cuid())
  accountNumber String   @unique
  bankCode      String?
  bankName      String?

  balance       Decimal  @default(15000) @db.Decimal(18, 2)

  customerId    String   @unique
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  outgoingTransactions Transaction[] @relation("SenderAccount")
  incomingTransactions Transaction[] @relation("ReceiverAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id            String            @id @default(cuid())
  transactionId String            @unique

  amount        Decimal           @db.Decimal(18, 2)

  fromAccount   String
  toAccount     String

  status        TransactionStatus @default(pending)

  senderAccount   Account  @relation("SenderAccount", fields: [fromAccount], references: [accountNumber])
  receiverAccount Account? @relation("ReceiverAccount", fields: [toAccount], references: [accountNumber])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromAccount])
  @@index([toAccount])
  @@index([createdAt])
}